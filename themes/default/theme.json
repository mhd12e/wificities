{
  "name": "Default",
  "description": "The standard WifiCities theme. Retro, customizable, yours.",
  "author": "wificities",
  "version": "1.0.0",
  "default_layout": "base",
  "layouts": {
    "base": {
      "description": "Standard layout (sidebar optional)",
      "file": "layouts/base.html"
    },
    "fullwidth": {
      "description": "Full width, no sidebar",
      "file": "layouts/fullwidth.html"
    }
  },
  "templates": {
    "home": {
      "description": "Homepage with welcome banner and widgets",
      "layout": "base"
    },
    "page": {
      "description": "Generic content page",
      "layout": "base"
    },
    "links": {
      "description": "Bookmarks and cool links page",
      "layout": "base"
    },
    "gallery": {
      "description": "Image gallery",
      "layout": "fullwidth"
    }
  },
  "palettes": {
    "midnight": {
      "name": "Midnight",
      "description": "Deep blue + green text. Classic hacker.",
      "bg_color": "#0a0a2e",
      "bg_secondary": "#12124a",
      "text_color": "#33ff33",
      "text_secondary": "#b0b0b0",
      "accent_color": "#ffff00",
      "accent_secondary": "#ff9900",
      "link_color": "#ff00ff",
      "link_hover": "#ffff00",
      "border_color": "#2a2a5e",
      "header_bg": "linear-gradient(180deg, #0a0a4e 0%, #0a0a2e 100%)",
      "header_accent": "#ff6600"
    },
    "sunset": {
      "name": "Sunset",
      "description": "Warm oranges + deep purples. Golden hour.",
      "bg_color": "#1a0a2e",
      "bg_secondary": "#2a1040",
      "text_color": "#ffd4a3",
      "text_secondary": "#c8a0c8",
      "accent_color": "#ff6b35",
      "accent_secondary": "#ffaa00",
      "link_color": "#ff6b9d",
      "link_hover": "#ffcc00",
      "border_color": "#4a2060",
      "header_bg": "linear-gradient(180deg, #3d1060 0%, #1a0a2e 100%)",
      "header_accent": "#ff6b35"
    },
    "ocean": {
      "name": "Ocean",
      "description": "Cool teal + white. Calm waters.",
      "bg_color": "#0a1628",
      "bg_secondary": "#0f2035",
      "text_color": "#e0f0ff",
      "text_secondary": "#88bbcc",
      "accent_color": "#00e5ff",
      "accent_secondary": "#0088aa",
      "link_color": "#00e5ff",
      "link_hover": "#ffffff",
      "border_color": "#1a3a4e",
      "header_bg": "linear-gradient(180deg, #0a2540 0%, #0a1628 100%)",
      "header_accent": "#00e5ff"
    },
    "forest": {
      "name": "Forest",
      "description": "Dark green + gold. Deep woods.",
      "bg_color": "#0a1a0a",
      "bg_secondary": "#122212",
      "text_color": "#c8e6c8",
      "text_secondary": "#88aa88",
      "accent_color": "#ffd700",
      "accent_secondary": "#cc9900",
      "link_color": "#88dd44",
      "link_hover": "#ffd700",
      "border_color": "#2a4a2a",
      "header_bg": "linear-gradient(180deg, #1a3a1a 0%, #0a1a0a 100%)",
      "header_accent": "#ffd700"
    },
    "cyberpunk": {
      "name": "Cyberpunk",
      "description": "Black + neon pink + cyan. Night city.",
      "bg_color": "#0a0a0a",
      "bg_secondary": "#1a1a1a",
      "text_color": "#e0e0e0",
      "text_secondary": "#888888",
      "accent_color": "#ff2d95",
      "accent_secondary": "#00fff2",
      "link_color": "#00fff2",
      "link_hover": "#ff2d95",
      "border_color": "#333333",
      "header_bg": "linear-gradient(180deg, #1a0020 0%, #0a0a0a 100%)",
      "header_accent": "#ff2d95"
    },
    "vaporwave": {
      "name": "Vaporwave",
      "description": "Pink + purple + teal. A E S T H E T I C.",
      "bg_color": "#1a0030",
      "bg_secondary": "#2a0848",
      "text_color": "#ff71ce",
      "text_secondary": "#b967ff",
      "accent_color": "#01cdfe",
      "accent_secondary": "#05ffa1",
      "link_color": "#fffb96",
      "link_hover": "#01cdfe",
      "border_color": "#4a1880",
      "header_bg": "linear-gradient(180deg, #3a0868 0%, #1a0030 100%)",
      "header_accent": "#01cdfe"
    },
    "terminal": {
      "name": "Terminal",
      "description": "Black + green. CRT monitor vibes.",
      "bg_color": "#0c0c0c",
      "bg_secondary": "#141414",
      "text_color": "#00ff00",
      "text_secondary": "#00aa00",
      "accent_color": "#00ff00",
      "accent_secondary": "#00cc00",
      "link_color": "#00ff00",
      "link_hover": "#00ff88",
      "border_color": "#003300",
      "header_bg": "#0c0c0c",
      "header_accent": "#00ff00"
    },
    "newspaper": {
      "name": "Newspaper",
      "description": "Cream + black. Old print feel.",
      "bg_color": "#f5f0e8",
      "bg_secondary": "#ebe5d8",
      "text_color": "#1a1a1a",
      "text_secondary": "#555555",
      "accent_color": "#cc0000",
      "accent_secondary": "#884400",
      "link_color": "#0044cc",
      "link_hover": "#cc0000",
      "border_color": "#c8c0b0",
      "header_bg": "#f5f0e8",
      "header_accent": "#cc0000"
    }
  },
  "header_styles": {
    "banner": "Full-width banner with site title and animated accent bar",
    "minimal": "Simple text header, no decoration",
    "centered": "Centered title block with decorative borders"
  },
  "variables": {
    "site_title": {
      "type": "string",
      "description": "Your site's name",
      "default": "My WifiCity"
    },
    "owner_name": {
      "type": "string",
      "description": "Your name or handle",
      "default": "Anonymous"
    },
    "bio": {
      "type": "text",
      "description": "A short welcome message",
      "default": "Welcome to my little corner of the airwaves!"
    },
    "palette": {
      "type": "string",
      "description": "Color palette (midnight, sunset, ocean, forest, cyberpunk, vaporwave, terminal, newspaper)",
      "default": "midnight"
    },
    "header_style": {
      "type": "string",
      "description": "Header style (banner, minimal, centered)",
      "default": "banner"
    },
    "font_heading": {
      "type": "string",
      "description": "Heading font",
      "default": "'Comic Sans MS', 'Chalkboard SE', cursive"
    },
    "font_body": {
      "type": "string",
      "description": "Body font",
      "default": "'Courier New', 'Lucida Console', monospace"
    },
    "show_guestbook": {
      "type": "boolean",
      "description": "Show guestbook on homepage",
      "default": true
    },
    "show_visitor_counter": {
      "type": "boolean",
      "description": "Show visitor counter in sidebar",
      "default": true
    },
    "show_sidebar": {
      "type": "boolean",
      "description": "Show sidebar",
      "default": true
    },
    "show_marquee": {
      "type": "boolean",
      "description": "Show scrolling marquee banner",
      "default": true
    },
    "show_construction": {
      "type": "boolean",
      "description": "Show 'under construction' banner",
      "default": true
    },
    "bg_color": { "type": "color", "description": "Background color", "default": "#0a0a2e" },
    "bg_secondary": { "type": "color", "description": "Secondary background", "default": "#12124a" },
    "text_color": { "type": "color", "description": "Text color", "default": "#33ff33" },
    "text_secondary": { "type": "color", "description": "Secondary text", "default": "#b0b0b0" },
    "accent_color": { "type": "color", "description": "Accent color", "default": "#ffff00" },
    "accent_secondary": { "type": "color", "description": "Secondary accent", "default": "#ff9900" },
    "link_color": { "type": "color", "description": "Link color", "default": "#ff00ff" },
    "link_hover": { "type": "color", "description": "Link hover color", "default": "#ffff00" },
    "border_color": { "type": "color", "description": "Border color", "default": "#2a2a5e" },
    "header_bg": { "type": "string", "description": "Header background", "default": "linear-gradient(180deg, #0a0a4e 0%, #0a0a2e 100%)" },
    "header_accent": { "type": "color", "description": "Header accent color", "default": "#ff6600" },
    "nav_links": {
      "type": "list",
      "description": "Navigation links",
      "default": [
        { "title": "Home", "url": "/" },
        { "title": "About", "url": "/about" }
      ]
    }
  }
}
