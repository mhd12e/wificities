#!/usr/bin/env bash
# WifiCities CLI wrapper — auto-bootstraps venv on first run.
set -e

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_DIR="$REPO_DIR/.venv"

# ---- Bootstrap venv if needed ----
if [ ! -f "$VENV_DIR/bin/activate" ]; then
    echo ""
    echo "  First run — setting up..."
    echo ""

    if ! command -v python3 &> /dev/null; then
        echo "  Python 3 is required."
        if [[ "$OSTYPE" == "darwin"* ]]; then echo "  brew install python3"
        elif [ -f /etc/debian_version ];    then echo "  sudo apt install python3"
        elif [ -f /etc/fedora-release ];    then echo "  sudo dnf install python3"
        elif [ -f /etc/arch-release ];      then echo "  sudo pacman -S python"
        else echo "  https://python.org"; fi
        exit 1
    fi

    echo -n "  Creating virtual environment..."
    python3 -m venv "$VENV_DIR"
    echo " done"

    source "$VENV_DIR/bin/activate"

    PKGS="click mistune esptool watchdog platformio littlefs-python"
    for pkg in $PKGS; do
        echo -n "  Installing $pkg..."
        pip install --disable-pip-version-check -q "$pkg" > /dev/null 2>&1
        echo " done"
    done

    # Compile firmware
    FIRMWARE_BIN="$REPO_DIR/firmware/.pio/build/esp32/firmware.bin"
    if [ ! -f "$FIRMWARE_BIN" ]; then
        echo ""
        echo "  Compiling ESP32 firmware (first time, ~1 min)..."
        cd "$REPO_DIR/firmware"
        if pio run -e esp32 > /tmp/wificities-build.log 2>&1; then
            echo "  Firmware ready."
        else
            echo "  Firmware compilation failed:"
            tail -5 /tmp/wificities-build.log
            echo "  Retry: cd firmware && pio run -e esp32"
        fi
        cd "$REPO_DIR"
    fi

    echo ""
    echo "  Setup complete. Run: ./wificities init my-site"
    echo ""

    # If no command was given, exit after setup
    if [ $# -eq 0 ]; then
        exit 0
    fi
fi

# ---- Run CLI ----
source "$VENV_DIR/bin/activate"
PYTHONPATH="$REPO_DIR/cli" exec python3 -c "from wificities.cli import main; main()" "$@"
